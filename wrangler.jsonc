{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name connected in Workers Builds must match this.
  "name": "abnormalhq",
  // The entry wraps the Worker generated by OpenNext with a layer of content negotiation; .open-next/worker.js is produced by pnpm cf:build.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: the Next.js server side depends on Node APIs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Custom domains are created by the deploy (see "Domains" in the README); a domain missing here is detached from this Worker on deploy and its DNS record deleted.
  "routes": [
    {
      "pattern": "abnormalhq.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
    // 301-redirected to abnormalhq.com by the redirects in next.config.ts.
    {
      "pattern": "www.abnormalhq.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
    // Old address: the zone's Redirect Rule 301s it to the new address before the Worker. It stays here to keep its DNS record; removing it would make this host unresolvable for about 30 minutes because of DNS negative caching.
    {
      "pattern": "abnormal.bid",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
    // The retired standalone storefront (abnormalhq/onboard): src/storefront/worker/legacy.ts 301s its pages to the same pages here and
    // keeps proxying its /api, so payment notifications still sent there arrive. Bind it only after removing it from the old
    // abnormalhq-onboard Worker (see "Retiring onboard" in the README).
    {
      "pattern": "onboard.abnormalhq.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
    // The storefront's older address: the zone's Redirect Rule sends it on before the Worker. It stays here to keep its DNS record, like abnormal.bid.
    {
      "pattern": "onboard.abnormal.bid",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The asset service answers a Range request with the whole file, and browsers need ranges to play video, so the promo videos
    // go through the Worker, which cuts the ranges (src/lib/range.ts). Everything else, the videos' poster images included, is still
    // served without running the Worker (with html_handling "none" a file is answered at its exact path, so /video/*.jpg needs nothing more).
    "run_worker_first": ["/video/*.mp4"],
    // OpenNext requires it once any path runs the Worker first: files are served at their exact path only, as Next.js does.
    // The assets hold no pages (those come from the Worker), so no address changes.
    "html_handling": "none",
  },
  "services": [
    // OpenNext uses it to call itself.
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "abnormalhq",
    },
    // The storefront API (src/storefront/worker/) calls mail's /api/onboard/* and /api/shop/* through it; abnormalhq-mailhq is in the same account.
    {
      "binding": "MAIL",
      "service": "abnormalhq-mailhq",
    },
  ],
  "vars": {
    // mail's production address, used only as the URL of internal requests so mail's OpenNext recognises its own origin; requests always go
    // through the MAIL binding. For local integration override it in .dev.vars (see .dev.vars.example).
    "MAIL_ORIGIN": "https://console.abnormalhq.com",
  },
  // The deployment's version (CF_VERSION_METADATA.id): src/lib/edge-cache.ts keys its cached pages by it, so none outlives a deploy.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "enabled": true,
  },
}
