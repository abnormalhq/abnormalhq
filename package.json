{
  "name": "abnormal-mail-services",
  "version": "1.5.0",
  "private": true,
  "description": "Abnormal email services website and storefront (shop, redeem page, buyer account) built with Next.js and Tailwind CSS, deployed to Cloudflare Workers with OpenNext.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4320",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts && vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "cf:build": "pnpm check && pnpm format:check && opennextjs-cloudflare build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8786",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api-reference": "node scripts/api-reference.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@stripe/stripe-js": "10.2.1",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@next/mdx": "16.4.5",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/canvas-confetti": "1.9.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "raw-loader": "^4.0.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-smartypants": "^3.0.2",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.16.1"
}
